# backend/.env 로 복사해서 사용하세요 (cp .env.example .env). .env 는 버전관리에 올리지 않습니다.
#
# 아래 값은 "개발용" 예시입니다. 운영 전에는 반드시 바꾸세요.
#  - ADMIN_PASSWORD_HASH 의 예시 값은 비밀번호 admin1234 의 해시입니다.
#    새 해시 만들기: python scripts/hash_password.py   (해시는 작은따옴표로 감싸세요)
#  - JWT_SECRET 은 32자 이상의 무작위 문자열이어야 합니다.
#    예: python -c "import secrets; print(secrets.token_urlsafe(48))"

STORE_ID=demo
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2b$12$VLsYZGdQkwGm3zYi20x46OYE0d1Jk4yqvxiZ9QVuY4dSyLdZM9KMS'
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# 선택 (기본값 표시)
# DB_PATH=data/table_order.sqlite3
# TOKEN_TTL_HOURS=16
# ADMIN_LOGIN_MAX_FAILURES=5
# ADMIN_LOGIN_LOCK_MINUTES=15
# TABLE_LOGIN_MAX_FAILURES=10
# TABLE_LOGIN_LOCK_MINUTES=5
# BCRYPT_ROUNDS=12
# FRONTEND_DIST=../frontend/dist
# TIMEZONE=Asia/Seoul            # 과거 주문 내역의 날짜 경계 (IANA 시간대 이름)
# SSE_KEEPALIVE_SECONDS=15       # 실시간 스트림 keep-alive 주기
# SSE_QUEUE_SIZE=100             # 구독자별 이벤트 큐 크기 (넘치면 연결을 끊음)
